<Window x:Class="DiscordQuestCompleter.SettingsWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		Title="Settings" Width="520" Height="155" ResizeMode="NoResize"
		WindowStartupLocation="CenterOwner" Background="#1b1c1f" Foreground="#dbdee1"
		PreviewKeyDown="Window_PreviewKeyDown">
	<Grid Margin="18">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
		<TextBlock Grid.Row="0" Text="Your steam directory:" FontWeight="Bold" Margin="0,0,0,8"/>
		<Grid Grid.Row="1">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>
			<TextBox x:Name="SteamDirectoryTextBox" Grid.Column="0" Padding="8" Background="#292a2e" Foreground="#dbdee1" BorderBrush="#3f4147" TextChanged="SteamDirectoryTextBox_TextChanged" ToolTip="Press Enter to save with Windows path separators"/>
			<Button x:Name="BrowseSteamDirectoryButton" Grid.Column="1" Margin="8,0,0,0" Width="40" Height="34" Padding="0" Background="#5865f2" Foreground="White" BorderThickness="0" ToolTip="Browse for folder" Click="BrowseSteamDirectory_Click">
				<TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
			</Button>
		</Grid>
	</Grid>
</Window>
