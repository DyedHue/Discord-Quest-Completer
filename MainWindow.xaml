<Window x:Class="DiscordQuestCompleter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Discord Quest Completer" Height="750" Width="1130" Background="#1b1c1f" Foreground="#dbdee1"
		Icon="app.ico"
        Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown" Activated="Window_Activated" PreviewMouseDown="Window_PreviewMouseDown">

	<Window.Resources>
		<Style TargetType="Button">
			<Setter Property="Background" Value="#5865f2"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="Padding" Value="10,8"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>
		<!-- TextBox Style -->
		<Style TargetType="TextBox">
			<Setter Property="Background" Value="#1b1c1f"/>
			<Setter Property="Foreground" Value="#dbdee1"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="BorderBrush" Value="#1b1c1f"/>
			<Setter Property="Padding" Value="8"/>
		</Style>
		<!-- ListBox Style -->
		<Style TargetType="ListBox">
			<Setter Property="Background" Value="#1b1c1f"/>
			<Setter Property="Foreground" Value="#dbdee1"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Padding" Value="5"/>
		</Style>

		<!-- TabItem Style for Darker/Lighter Background -->
		<Style TargetType="TabItem">
			<Setter Property="Background" Value="#1b1c1f"/>
			<Setter Property="Foreground" Value="#949ba4"/>
			<Setter Property="Padding" Value="20,10"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Margin" Value="0,0,2,0"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="TabItem">
						<Border x:Name="Border" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6,6,0,0">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" ContentSource="Header"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsSelected" Value="True">
								<Setter TargetName="Border" Property="Background" Value="#292a2e"/>
								<Setter Property="Foreground" Value="White"/>
							</Trigger>
							<MultiTrigger>
								<MultiTrigger.Conditions>
									<Condition SourceName="Border" Property="IsMouseOver" Value="True"/>
									<Condition Property="IsSelected" Value="False"/>
								</MultiTrigger.Conditions>
								<Setter TargetName="Border" Property="Background" Value="#18191c"/>
								<Setter Property="Foreground" Value="White"/>
							</MultiTrigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- Custom ListBoxItem for Generated Games (Bigger, Borders, Selectable) -->
		<Style x:Key="GeneratedGameItemStyle" TargetType="ListBoxItem">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Foreground" Value="#dbdee1"/>
			<Setter Property="Tag" Value="#949ba4"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Margin" Value="2"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ListBoxItem">
						<Border BorderBrush="#3f4147" BorderThickness="1" CornerRadius="6" Background="{TemplateBinding Background}" Padding="2">
							<ContentPresenter/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsSelected" Value="True">
								<Setter Property="Background" Value="#3b8ed0"/>
								<Setter Property="Foreground" Value="White"/>
								<Setter Property="Tag" Value="#f0f0f0"/>
							</Trigger>
							<MultiTrigger>
								<MultiTrigger.Conditions>
									<Condition Property="IsMouseOver" Value="True"/>
									<Condition Property="IsSelected" Value="False"/>
								</MultiTrigger.Conditions>
								<Setter Property="Background" Value="#313338"/>
							</MultiTrigger>
							<MultiTrigger>
								<MultiTrigger.Conditions>
									<Condition Property="IsMouseOver" Value="True"/>
									<Condition Property="IsSelected" Value="True"/>
								</MultiTrigger.Conditions>
								<Setter Property="Background" Value="#2c78b3"/>
							</MultiTrigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>

	<Grid Margin="15">
		<Grid.RowDefinitions>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="65*"/>
			<ColumnDefinition Width="35*"/>
		</Grid.ColumnDefinitions>

		<!-- Left Panel: Tabs -->
		<TabControl x:Name="Tabs" Grid.Row="0" Grid.Column="0" Margin="0,0,15,8" Background="#292a2e" BorderThickness="0">
			<!-- Auto Search Tab -->
			<TabItem Header="Search Mode">
				<Grid Margin="15">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>

					<Grid Grid.Row="0" Margin="0,0,0,15">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>

						<TextBox x:Name="SearchBox" Grid.Column="0" 
								 Text="Search by name, game id or game link" Foreground="Gray"
								 GotFocus="SearchBox_GotFocus" LostFocus="SearchBox_LostFocus"
								 TextChanged="SearchBox_TextChanged"/>

						<Button x:Name="RefetchButton" Grid.Column="1" Margin="8,0,0,0" Width="36" Height="32" Click="RefetchButton_Click"
								ToolTip="Refetch search database (~11MB download)">
							<TextBlock Text="⟳" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Button>
					</Grid>

					<Grid Grid.Row="1">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="1*"/>
							<ColumnDefinition Width="1*"/>
						</Grid.ColumnDefinitions>

						<DockPanel Grid.Column="0" Margin="0,0,8,0">
							<TextBlock Text="Select Game:" FontWeight="Bold" DockPanel.Dock="Top" Margin="0,0,0,5"/>
							<ListBox x:Name="GamesList" DisplayMemberPath="name" SelectionChanged="GamesList_SelectionChanged"/>
						</DockPanel>

						<DockPanel Grid.Column="1" Margin="8,0,0,0">
							<TextBlock Text="Select Path:" FontWeight="Bold" DockPanel.Dock="Top" Margin="0,0,0,5"/>
							<ListBox x:Name="PathsList"/>
						</DockPanel>
					</Grid>

					<!-- Search Action Buttons -->
					<Grid Grid.Row="2" Margin="0,15,0,0">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="5*"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>
						<Button Grid.Column="0" Margin="0,0,5,0" Content="Create Dummy Game (Enter)" Background="#3ba55c" Click="CreateGame_Click" Padding="10,2"/>
						<Button Grid.Column="1" Margin="5,0,0,0" Content="✏️" Background="#6c757d" Click="CopyToManual_Click" ToolTip="Edit in Manual Fields"/>
					</Grid>
				</Grid>
			</TabItem>

			<!-- Manual Tab -->
			<TabItem Header="Manual Mode">
				<StackPanel Margin="15">
					<TextBlock Text="Game Name (Optional):" Margin="0,0,0,5" FontWeight="Bold"/>
					<TextBox x:Name="ManualName" Margin="0,0,0,15"/>

					<TextBlock Text="EXE Path (Required):" Margin="0,0,0,5" FontWeight="Bold"/>
					<TextBox x:Name="ManualPath" Margin="0,0,0,20"/>

					<Button Content="Create Dummy Game (Enter)" Background="#3ba55c" Click="CreateGame_Click" Padding="10,12"/>
				</StackPanel>
			</TabItem>
		</TabControl>

		<!-- Right Panel: Generated Games -->
		<Border Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" Background="#292a2e" CornerRadius="6" Padding="15">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<TextBlock Grid.Row="0" Text="Generated Dummy Games" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

				<ListBox x:Name="GeneratedGamesList" Grid.Row="1" Background="Transparent" BorderThickness="0" 
                         ItemContainerStyle="{StaticResource GeneratedGameItemStyle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="GeneratedGamesList_SelectionChanged" MouseDoubleClick="GeneratedGamesList_MouseDoubleClick">
					<ListBox.ItemsPanel>
						<ItemsPanelTemplate>
							<WrapPanel Orientation="Horizontal" />
						</ItemsPanelTemplate>
					</ListBox.ItemsPanel>
					<ListBox.ItemTemplate>
						<DataTemplate>
							<StackPanel Width="64" Margin="2,4,2,2" ToolTip="{Binding RelativePath}">
								<Grid Width="56" Height="56" Margin="0,0,0,5" HorizontalAlignment="Center">
									<Rectangle x:Name="IconRect" RadiusX="8" RadiusY="8" Fill="Transparent" Stroke="#3f4147" StrokeThickness="1" />
									<Border CornerRadius="4" Padding="4,1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,-6">
										<Border.Style>
											<Style TargetType="Border">
												<Setter Property="Visibility" Value="Collapsed"/>
												<Setter Property="Background" Value="#23a559"/>
												<Style.Triggers>
													<DataTrigger Binding="{Binding IsRunning}" Value="True">
														<Setter Property="Visibility" Value="Visible"/>
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</Border.Style>
										<TextBlock Text="RUNNING" Foreground="White" FontWeight="Bold" FontSize="7" />
									</Border>
								</Grid>
								<TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}" MaxHeight="30" TextTrimming="CharacterEllipsis"/>
							</StackPanel>
							<DataTemplate.Triggers>
								<DataTrigger Binding="{Binding HasIcon}" Value="True">
									<Setter TargetName="IconRect" Property="Fill">
										<Setter.Value>
											<ImageBrush ImageSource="{Binding IconUrl}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="LowQuality" RenderOptions.CachingHint="Cache" />
										</Setter.Value>
									</Setter>
								</DataTrigger>
							</DataTemplate.Triggers>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>

				<!-- Generated Games Action Buttons -->
				<Grid Grid.Row="2" Margin="0,15,0,0">
					<Grid x:Name="NotRunningButtons" Visibility="Visible">
						<Grid.ColumnDefinitions>
							<!-- Run button gets 3 parts of space -->
							<ColumnDefinition Width="3*"/>
							<!-- Edit & Delete each get 1 part -->
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>

						<Button Grid.Column="0" Content="Run" Margin="0,0,5,0" Background="#2d90fa" Click="RunGame_Click"/>
						<Button Grid.Column="1" Content="✏️" Margin="5,0,5,0" Background="#ffc107" Foreground="Black" Click="EditGame_Click" ToolTip="Edit Name or Path"/>
						<Button Grid.Column="2" Content="🗑️" Margin="5,0,0,0" Background="#ed4245" Click="DeleteGame_Click" ToolTip="Delete the dummy game"/>
					</Grid>

					<Button x:Name="StopButton" Content="Stop" Background="#ed4245" Visibility="Collapsed" Click="StopGame_Click"/>
				</Grid>
			</Grid>
		</Border>

		<!-- Footer Settings -->
		<Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,5" Background="#292a2e" CornerRadius="6" Padding="10,5">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>
				<StackPanel Grid.Column="0">
					<StackPanel Orientation="Horizontal" Margin="0,0,0,5">
						<CheckBox x:Name="AutoRunCheckBox" Content="Run automatically after creating" Foreground="#dbdee1" Margin="0,0,25,0" Checked="Setting_Changed" Unchecked="Setting_Changed" VerticalAlignment="Center" ToolTip="Launch a game automatically right after you create a dummy game"/>
						<CheckBox x:Name="CloseOnLaunchCheckBox" Content="Close this window after launching" Foreground="#dbdee1" Margin="0,0,25,0" Checked="Setting_Changed" Unchecked="Setting_Changed" VerticalAlignment="Center" ToolTip="Close this window automatically right after you launch a game"/>
						<CheckBox x:Name="StartMinimizedCheckBox" Content="Start games minimized" Foreground="#dbdee1" Checked="Setting_Changed" Unchecked="Setting_Changed" VerticalAlignment="Center" ToolTip="When you launch a game, the game window will automatically start as minimized"/>
					</StackPanel>
					<StackPanel Orientation="Horizontal" Margin="0,0,0,5">
						<TextBlock Text="After " Foreground="#dbdee1" VerticalAlignment="Center"/>
						<TextBox x:Name="TimerMinutesTextBox" Width="40" Height="20" Padding="0,-1,0,0" Text="15.5" Margin="5,0,5,0" TextChanged="Setting_Changed" VerticalAlignment="Center"/>
						<TextBlock Text=" minutes:" Foreground="#dbdee1" VerticalAlignment="Center" Margin="0,0,15,0"/>
						<CheckBox x:Name="CloseGameTimerCheckBox" Content="Close the game" Foreground="#dbdee1" Margin="0,0,25,0" Checked="Setting_Changed" Unchecked="Setting_Changed" VerticalAlignment="Center" ToolTip="When you launch a game while this setting is on,&#x0a;the game window will automatically close after the specified time"/>
					</StackPanel>
					<StackPanel Orientation="Horizontal">
						<Border Width="143"/>
						<CheckBox x:Name="SendNotificationCheckBox" Content="Send a notification" Foreground="#dbdee1" Checked="Setting_Changed" Unchecked="Setting_Changed" VerticalAlignment="Center" ToolTip="When you launch a game while this setting is on,&#x0a;you will receive a notification after the specified time"/>
					</StackPanel>
				</StackPanel>
				<StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
					<Button Content="📁" Background="#3f4147" ToolTip="Show the app's folder" Padding="8,4" Margin="0,0,0,4" Click="OpenAppFolder_Click"/>
					<Button Background="#3f4147" Padding="4,4" Click="OpenGitHubReleases_Click" ToolTip="Go to the repository on Github">
						<Image Source="/GitHub_Invertocat_White.png" Width="16" Height="16"/>
					</Button>
				</StackPanel>
			</Grid>
		</Border>

		<!-- Footer Status -->
		<Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>
			<TextBlock Grid.Column="0" x:Name="StatusText" Foreground="#949ba4" FontWeight="SemiBold"/>
			<TextBlock Grid.Column="1" x:Name="UpdateText" Foreground="#7889e3" FontWeight="Bold" Cursor="Hand" Visibility="Collapsed" MouseLeftButtonUp="OpenGitHubReleases_Click">
				<Underline>New update available!</Underline>
			</TextBlock>
		</Grid>
	</Grid>
</Window>
